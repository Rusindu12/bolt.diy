# Normalise line endings across platforms.
* text=auto eol=lf

# Gradle wrapper: the shell script must keep LF, the batch file must keep CRLF,
# otherwise `./gradlew` fails on macOS/Linux ("bad interpreter").
android/gradlew text eol=lf
android/gradlew.bat text eol=crlf

# Binary assets.
*.jar binary
*.jks binary
*.keystore binary
*.png binary
