<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup/transfer rules.

  API keys live in the Keystore-backed secure storage and must never leave the
  device through cloud backups or device-to-device transfers, so both channels
  are disabled entirely (the app is also declared with allowBackup="false").
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
