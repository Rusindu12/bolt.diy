# Release signing template.
#
# 1. Create a keystore (keep it safe - you need it for every future update):
#
#    keytool -genkey -v -keystore ~/binance-trader-release.jks \
#      -keyalg RSA -keysize 2048 -validity 10000 -alias binance_trader
#
# 2. Copy this file to android/key.properties and fill in the values:
#
#    storePassword=<the password you chose>
#    keyPassword=<the key password>
#    keyAlias=binance_trader
#    storeFile=/absolute/path/to/binance-trader-release.jks
#
# 3. `flutter build apk --release` then signs the APK with this key.
#    Without this file the release build is signed with the debug key, which is
#    installable on a phone but must never be published.
#
# android/key.properties and *.jks are ignored by .gitignore - never commit them.

storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=binance_trader
storeFile=/absolute/path/to/your/keystore.jks
